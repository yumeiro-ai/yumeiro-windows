# 手工/本地开发用示例。服务器部署请直接运行 ./install.sh，它会生成 .env 和 secrets/。
PORT=8787
COOKIE_SECURE=false
TRUST_PROXY=false
STORE_ENCRYPTION_KEY_FILE=./secrets/store_encryption_key   # base64 的 32 字节随机密钥
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_FILE=./secrets/admin_password               # 至少 16 个字符，仅首次启动读取
MODEL_BASE_URL=https://api.example.com/v1
MODEL_NAME=your-model-name
MODEL_API_KEY_FILE=./secrets/model_api_key
# MODEL_EXTRA_NAMES=model-b,model-c
# MODEL_SYSTEM_PROMPT=你是 Yumeiro，一个简洁可靠的中文助手。
# MODEL_CONTEXT_MESSAGES=24
# QUOTA_WARN_PERCENT=80

# 存储：不设置 PGHOST/DATABASE_URL 则使用 data/store.json
# STORAGE=postgres            # json | postgres | auto
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=yumeiro
# PGDATABASE=yumeiro
# PGPASSWORD_FILE=./secrets/db_password
# PGSSLMODE=require
# JSON_MIRROR=true            # PostgreSQL 模式下同时写加密 JSON，作为随时可切回的回退
# CINDY_ALLOW_SHARED_ACCOUNTS=1  # 允许主账号把 Cindy 账号共享给团队，默认关闭。打开前请先确认 Cindy 官方服务条款允许多人共用一个订阅额度
